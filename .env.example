# Copie para .env e preencha. O .env não vai para o git.
# Chave da API da Anthropic, usada na análise por IA e no chat (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# Token do GitHub (opcional), só para a IA ler o código de repositórios privados.
# Use um token "fine-grained" com permissão só de leitura de conteúdo (Contents: Read-only).
GITHUB_TOKEN=
# Token de escrita (opcional), só para as correções automáticas abrirem um PR em rascunho.
# Use outro token "fine-grained", restrito aos repositórios alvo, com Contents: Read and write
# e Pull requests: Read and write. Ele nunca é entregue ao agente: só o passo que publica o usa.
PR_GITHUB_TOKEN=
